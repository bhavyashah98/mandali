{
  "expo": {
    "name": "Mandali",
    "slug": "mandali",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mandali",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf9f3"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.mandaliapp.mandaliapp",
      "buildNumber": "14",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:api.mandaliapp.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Mandali to select and upload photos from your gallery to your group memories.",
        "NSPhotoLibraryAddUsageDescription": "Allow Mandali to save shared photos from your group memories to your device.",
        "NSCameraUsageDescription": "Allow Mandali to use your camera to take photos and add them to group memories.",
        "NSUserNotificationUsageDescription": "Stay updated with memories and game updates.",
        "NSLocationWhenInUseUsageDescription": "Mandali uses your location to pick a place for your plan on the map.",
        "NSLocationAlwaysUsageDescription": "Mandali uses your location to pick a place for your plan on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Mandali uses your location to pick a place for your plan on the map.",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.mandaliapp.mandali",
      "versionCode": 14,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fdf9f3"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.mandaliapp.com",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "api.mandaliapp.com",
              "pathPrefix": "/housie"
            },
            {
              "scheme": "https",
              "host": "api.mandaliapp.com",
              "pathPrefix": "/memories"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBLUn3uIoQh1oMhhuZ4lbeFldGUHOYmzog"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#b30069"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mandali uses your camera to add photos to group memories"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mandali accesses your photos to add them to group memories",
          "cameraPermission": "Mandali uses your camera to add photos to group memories"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp"
            ]
          },
          "android": {
            "allowBackup": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mandali uses your location to pick a place for your plan on the map.",
          "locationAlwaysAndWhenInUsePermission": "Mandali uses your location to pick a place for your plan on the map.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e1529036-31cd-46d2-8c2b-82ca9d69387c"
      }
    }
  }
}
