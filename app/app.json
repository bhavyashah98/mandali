{
  "expo": {
    "name": "Mandali",
    "slug": "mandali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mandali",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf9f3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandaliapp.mandali",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Mandali uses your camera to add photos to group memories",
        "NSPhotoLibraryUsageDescription": "Mandali accesses your photos to add them to group memories",
        "NSPhotoLibraryAddUsageDescription": "Mandali saves photos to your library",
        "NSUserNotificationUsageDescription": "Mandali sends notifications about your group activity"
      }
    },
    "android": {
      "package": "com.mandaliapp.mandali",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fdf9f3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Mandali uses your camera to add photos to group memories"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mandali accesses your photos to add them to group memories",
          "cameraPermission": "Mandali uses your camera to add photos to group memories"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e1529036-31cd-46d2-8c2b-82ca9d69387c"
      }
    }
  }
}