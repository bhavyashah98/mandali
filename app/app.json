{
  "expo": {
    "name": "Mandali",
    "slug": "mandali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mandali",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fdf9f3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mandaliapp.mandali",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:api.mandaliapp.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Mandali uses your camera to add photos to group memories",
        "NSPhotoLibraryUsageDescription": "Mandali accesses your photos to add them to group memories",
        "NSPhotoLibraryAddUsageDescription": "Mandali saves photos to your library",
        "NSUserNotificationUsageDescription": "Mandali sends notifications about your group activity",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mandaliapp.mandali",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fdf9f3"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.mandaliapp.com",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Mandali uses your camera to add photos to group memories"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mandali accesses your photos to add them to group memories",
          "cameraPermission": "Mandali uses your camera to add photos to group memories"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "e1529036-31cd-46d2-8c2b-82ca9d69387c"
      }
    }
  }
}